<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows replaces the root's own padding with inset values,
     so the 22dp gutter lives one level down. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="22dp">

    <TextView
        style="@style/Mutter.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="28dp"
        android:text="@string/settings_title" />

    <!-- Dictation -->
    <TextView
        style="@style/Mutter.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="32dp"
        android:text="@string/settings_section_dictation" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/Mutter.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_intercept_enabled" />
            <TextView
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/settings_intercept_enabled_desc" />
        </LinearLayout>
        <ToggleButton
            android:id="@+id/toggle_intercept"
            style="@style/Mutter.Toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textOn="@string/toggle_on"
            android:textOff="@string/toggle_off" />
    </LinearLayout>

    <View style="@style/Mutter.Hairline" />

    <!-- Updates -->
    <TextView
        style="@style/Mutter.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:text="@string/settings_updates" />
    <TextView
        style="@style/Mutter.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="@string/settings_updates_desc" />
    <TextView
        android:id="@+id/updater_status"
        style="@style/Mutter.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:textColor="@color/text_dim" />
    <Button
        android:id="@+id/btn_check_updates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="24dp"
        android:text="@string/action_check_updates" />

    <View style="@style/Mutter.Hairline" />

    <!-- About -->
    <TextView
        style="@style/Mutter.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:text="@string/settings_about" />
    <TextView
        android:id="@+id/about_text"
        style="@style/Mutter.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="@color/text_dim" />
</LinearLayout>
</FrameLayout>
