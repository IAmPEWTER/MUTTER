<?xml version="1.0" encoding="utf-8"?>
<!-- Margo design language: flat dark theme, Geist type ramp, no Material widgets.
     letterSpacing is em-based: Margo 1.6sp tracking at 10sp = 0.16em, at 12sp = 0.13em. -->
<resources>
    <style name="Theme.Mutter" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="colorAccent">@color/text</item>
        <item name="android:colorEdgeEffect">@color/hairline</item>
        <item name="buttonStyle">@style/Mutter.Button</item>
        <item name="android:buttonStyle">@style/Mutter.Button</item>
    </style>

    <!-- Type ramp -->
    <style name="Mutter.Display" parent="">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Mutter.Heading" parent="">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Mutter.Label" parent="">
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Mutter.Body" parent="">
        <item name="android:fontFamily">@font/geist_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Mutter.Sub" parent="">
        <item name="android:fontFamily">@font/geist_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="Mutter.Status" parent="">
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="Mutter.Hairline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/hairline</item>
    </style>

    <!-- ON/OFF text pill (Margo ConvoToggle). -->
    <style name="Mutter.Toggle" parent="">
        <item name="android:background">@drawable/toggle_pill</item>
        <item name="android:textColor">@color/toggle_pill_text</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Pill button: hairline border, inverts to light fill on press. No ripple. -->
    <style name="Mutter.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/btn_pill</item>
        <item name="android:textColor">@color/btn_pill_text</item>
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
