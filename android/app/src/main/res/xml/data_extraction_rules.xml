<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" only governs Android 11 and below. Android 12 split it
     into cloud backup and device transfer, and neither should carry this app's
     data: the model cache is a re-downloadable ~280 MB blob and the only pref
     is one boolean. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
