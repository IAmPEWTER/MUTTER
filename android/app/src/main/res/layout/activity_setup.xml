<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <!-- fitsSystemWindows replaces the root's own padding with inset values,
         so the 22dp gutter lives one level down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp">

        <!-- Hero -->
        <TextView
            style="@style/Mutter.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="36dp"
            android:text="@string/app_name" />
        <TextView
            style="@style/Mutter.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="28dp"
            android:text="@string/setup_tagline" />

        <View style="@style/Mutter.Hairline" />

        <!-- Step 1: Microphone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    style="@style/Mutter.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_step_mic" />
                <TextView
                    android:id="@+id/status_mic"
                    style="@style/Mutter.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/setup_step_mic_desc" />
            <Button
                android:id="@+id/btn_mic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:text="@string/action_grant" />
        </LinearLayout>

        <View style="@style/Mutter.Hairline" />

        <!-- Step 2: Restricted settings (Android 13+ accessibility gate) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="18dp">
            <TextView
                style="@style/Mutter.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_step_restricted" />
            <TextView
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/setup_step_restricted_desc" />
            <Button
                android:id="@+id/btn_restricted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:text="@string/action_open_app_info" />
        </LinearLayout>

        <View style="@style/Mutter.Hairline" />

        <!-- Step 3: Accessibility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    style="@style/Mutter.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_step_accessibility" />
                <TextView
                    android:id="@+id/status_accessibility"
                    style="@style/Mutter.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/setup_step_accessibility_desc" />
            <Button
                android:id="@+id/btn_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:text="@string/action_enable" />
        </LinearLayout>

        <View style="@style/Mutter.Hairline" />

        <!-- Step 4: Battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    style="@style/Mutter.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_step_battery" />
                <TextView
                    android:id="@+id/status_battery"
                    style="@style/Mutter.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/setup_step_battery_desc" />
            <Button
                android:id="@+id/btn_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:text="@string/action_open_settings" />
        </LinearLayout>

        <View style="@style/Mutter.Hairline" />

        <!-- Step 5: Model download -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="18dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    style="@style/Mutter.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setup_step_model" />
                <TextView
                    android:id="@+id/status_model"
                    style="@style/Mutter.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/setup_step_model_desc" />
            <Button
                android:id="@+id/btn_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:text="@string/action_download" />
            <ProgressBar
                android:id="@+id/progress_model"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="4dp"
                android:maxHeight="4dp"
                android:progressDrawable="@drawable/progress_line"
                android:visibility="gone" />
            <TextView
                android:id="@+id/model_detail"
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <View style="@style/Mutter.Hairline" />

        <!-- Step 6: Test field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="18dp">
            <TextView
                style="@style/Mutter.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_step_test" />
            <TextView
                style="@style/Mutter.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/setup_step_test_desc" />
            <EditText
                android:id="@+id/test_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/edit_field"
                android:fontFamily="@font/geist_regular"
                android:textSize="15sp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:hint="@string/setup_test_hint"
                android:padding="14dp"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top|start"
                android:importantForAutofill="no" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:text="@string/action_settings" />
    </LinearLayout>
</ScrollView>
